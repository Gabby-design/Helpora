# Helpora Nigeria — Environment Variables Configuration

# Google Generative AI (Gemini) API Key
# Used server-side in /api/study/tutor for the AI Study Companion.
# Get an API key from Google AI Studio: https://aistudio.google.com/
# If left unset or invalid, Helpora provides a built-in pedagogical fallback engine.
GEMINI_API_KEY=

# App Base URL (used for OAuth redirects and email callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Free tier Auth, Postgres, Storage)
# Required for live Supabase Auth and database operations.
# If unset, Helpora runs in resilient local developer mode with zero crashes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare Turnstile Bot Protection (Optional)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# If unset, auth requests bypass Turnstile checks in development/testing mode.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Server Port & Mode
PORT=3000
NODE_ENV=development
