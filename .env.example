# CivicTrust Environment Variables Configuration

# Google Generative AI (Gemini) API Key
# Used server-side in /api/study/tutor for the AI Study Companion.
# Get an API key from Google AI Studio: https://aistudio.google.com/
# If left unset or invalid, CivicTrust provides a built-in pedagogical fallback engine.
GEMINI_API_KEY=

# Server Port (Default is 3000)
PORT=3000

# Node Environment
NODE_ENV=development
